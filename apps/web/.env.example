# VoltMesh Web Frontend — copy to apps/web/.env for local dev, or set in Vercel.
# Only VITE_* variables are exposed to the browser bundle. NEVER put secrets here.

# --- Network (e.g. Base Sepolia 84532 or Polygon Amoy 80002) ---
# VITE_CHAIN_ID=84532
# VITE_RPC_URL=https://sepolia.base.org
VITE_CHAIN_ID=80002
VITE_RPC_URL=https://rpc-amoy.polygon.technology

# --- Backend (single URL var) ---
VITE_API_URL=https://your-backend.up.railway.app

# --- Contract addresses (required for all non-31337 chains; printed by DeployAmoy) ---
VITE_ACCESS_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_PARTICIPANT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_DEVICE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_EPOCH_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MOCK_ERC20_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
VITE_BATCH_SETTLEMENT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_CERTIFICATE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_RETIREMENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# --- Google OAuth (public client id only) ---
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Local devnet only (uncomment for Anvil) ---
# VITE_USE_LOCAL=true
# VITE_DEMO_MODE=true
