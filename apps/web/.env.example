# ==============================================================================
# VoltMesh Web App Environment Variables (.env.example)
# ==============================================================================

# Target chain ID: 80002 for Polygon Amoy Testnet (default in production), or 31337 for local devnet
VITE_CHAIN_ID=80002

# Set to true ONLY for local Hardhat/Anvil devnet development.
# When false (or unset), the app strictly requires live public testnet contracts and never falls back to 127.0.0.1:8545.
VITE_USE_LOCAL=false

# JSON-RPC URL for Polygon Amoy
VITE_RPC_URL=https://rpc-amoy.polygon.technology

# Backend Core API URL (must NOT have a trailing slash)
VITE_BACKEND_URL=https://energy-dexapi-production.up.railway.app
VITE_API_URL=https://energy-dexapi-production.up.railway.app

# Contract Addresses (deployed on Polygon Amoy or target chain)
VITE_ACCESS_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_PARTICIPANT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_DEVICE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_EPOCH_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MOCK_ERC20_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
VITE_BATCH_SETTLEMENT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_CERTIFICATE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_RETIREMENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Optional demo flag (only active if VITE_USE_LOCAL=true)
VITE_DEMO_MODE=false
