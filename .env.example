# VoltMesh Server Environment Configuration

# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=dex-super-secret-key-32-chars-long!
ALLOW_DEV_KEYS=true
SANDBOX_MODE=true
CHAIN_ID=31337

# Blockchain Contracts (Defaults are Anvil devnet)
BATCH_SETTLEMENT_ADDRESS=0x8A791620dd6260079BF849Dc5567aDC3F2FdC318
EPOCH_ORACLE_ADDRESS=0x0165878A594ca255338adfa4d48449f69242Eb8F
MOCK_ERC20_ADDRESS=0xa513E6E4b8f2a923D98304ec87F64353C4D5C853
AUDITOR_ADDRESS=0x13e21cccB6fcB1E03105b6243Af4563280E56FDd

# External Advisory Market Data
MARKET_DATA_PROVIDER=mock   # openmeteo | mock
PRICE_PROVIDER=mock         # iexcsv | mock
ZONE_LAT=28.61              # Delhi Zone 1 Latitude
ZONE_LON=77.21              # Delhi Zone 1 Longitude
IEX_DATA_DIR=./data/iex     # Path for manual IEX CSV drops

# Web Frontend Environment
VITE_API_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security Advisor Configuration (Server-side ONLY; never expose API keys to browser)
ADVISOR_ENABLED=false
LLM_PROVIDER=mock           # mock | anthropic | openai-compatible | ollama
# ANTHROPIC_API_KEY=sk-ant-api03-... # Server only! Never prefix with VITE_
# LLM_MODEL=claude-3-5-sonnet-20241022
# For Ollama / local LLM:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3
