# ==============================================================================
# VoltMesh Core API Server Environment Variables (.env.example)
# ==============================================================================

PORT=3000
NODE_ENV=production

# High-entropy JWT secret (strictly required >= 32 chars in production)
JWT_SECRET=replace-with-at-least-32-chars-long-secure-secret-key!

# Allow dev keys (set to false for production / testnets)
ALLOW_DEV_KEYS=false

# Target network: 80002 for Polygon Amoy, 31337 for local devnet
CHAIN_ID=80002
RPC_URL=https://rpc-amoy.polygon.technology

# Frontend CORS origins allowed to call this API (comma-separated or single URL)
FRONTEND_ORIGIN=https://voltmesh-ivory.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=https://voltmesh-ivory.vercel.app,http://localhost:5173

# Sandbox mode flag
SANDBOX_MODE=true

# Contract addresses on target network (read by API for role lookups and verification)
ACCESS_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
PARTICIPANT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
DEVICE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
EPOCH_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
BATCH_SETTLEMENT_ADDRESS=0x0000000000000000000000000000000000000000
MOCK_ERC20_ADDRESS=0x0000000000000000000000000000000000000000
